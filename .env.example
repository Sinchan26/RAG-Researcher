# Copy to .env and update locally. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Replace with your manually provisioned database and role.
DATABASE_URL=postgresql+asyncpg://rag_user:replace-me@localhost:5432/rag_researcher
DATABASE_TIMEOUT_SECONDS=3
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=rag-researcher
